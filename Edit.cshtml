@{ System.Globalization.CultureInfo.CurrentCulture = new System.Globalization.CultureInfo("pt-BR"); }

@model IfoodClone.Models.Restaurante

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Restaurante</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cnpj" class="control-label"></label>
                <input asp-for="Cnpj" class="form-control" />
                <span asp-validation-for="Cnpj" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Categoria" class="control-label"></label>
                <input asp-for="Categoria" class="form-control" />
                <span asp-validation-for="Categoria" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TaxaEntrega" class="control-label"></label>
                <input asp-for="TaxaEntrega" class="form-control" />
                <span asp-validation-for="TaxaEntrega" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PedidoMinimo" class="control-label"></label>
                <input asp-for="PedidoMinimo" class="form-control" />
                <span asp-validation-for="PedidoMinimo" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Ativo" /> @Html.DisplayNameFor(model => model.Ativo)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="ContaId" class="control-label"></label>
                <input asp-for="ContaId" class="form-control" />
                <span asp-validation-for="ContaId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
